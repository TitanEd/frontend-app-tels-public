NODE_ENV='development'
PORT=8080
ACCESS_TOKEN_COOKIE_NAME='edx-jwt-cookie-header-payload'
BASE_URL='http://localhost:8080'
# Matches production's default MFE mount (tutor-tels-theme-plugins plugin.py
# HOME_URL="/public") — drives webpack's publicPath + frontend-platform's
# router basename (both read PUBLIC_PATH natively) AND localIndigoConfig.ts's
# INDIGO_HOME_URL, so header/footer links, asset URLs, and client-side route
# matching all agree the app lives under /public, not the server root.
PUBLIC_PATH='/public'
CREDENTIALS_BASE_URL='http://localhost:18150'
CSRF_TOKEN_API_PATH='/csrf/api/v1/token'
ECOMMERCE_BASE_URL='http://localhost:18130'
LANGUAGE_PREFERENCE_COOKIE_NAME='openedx-language-preference'
LMS_BASE_URL='http://localhost:18000'
LOGIN_URL='http://localhost:18000/login'
LOGOUT_URL='http://localhost:18000/logout'
LOGO_URL=https://titaned.com/wp-content/uploads/2023/07/TitanEdLogoHigherEdOrange.png
LOGO_TRADEMARK_URL=https://titaned.com/wp-content/uploads/2023/07/TitanEdLogoHigherEdOrange.png
LOGO_WHITE_URL=https://titaned.com/wp-content/uploads/2023/07/TitanEdLogoHigherEdOrange.png
FAVICON_URL=https://edx-cdn.org/v3/default/favicon.ico
MARKETING_SITE_BASE_URL='http://localhost:8080'
ORDER_HISTORY_URL='http://localhost:1996/orders'
REFRESH_ACCESS_TOKEN_ENDPOINT='http://localhost:18000/login_refresh'
SEGMENT_KEY=''
SITE_NAME=TitanEd
USER_INFO_COOKIE_NAME='edx-user-info'
APP_ID='public'
MFE_CONFIG_API_URL=''
# Left empty deliberately, matching every other locally-mounted MFE
# (frontend-app-learning, frontend-app-authoring, ...) in this workspace.
# frontend-platform reads MFE_CONFIG_API_URL (see below) and fetches
# PARAGON_THEME_URLS at runtime from /api/mfe_config/v1, which the LMS
# serves already pointed at the live `ui_configuration` brand endpoint
# (LMS_ROOT_URL + /ui_configuration/theme/{core,light,dark}.min.css).
# A non-empty value here gets baked as static <link rel=preload> tags into
# index.html at webpack-build time (by @edx/frontend-build), which then
# WINS over/duplicates that runtime-fetched config -- if it points at a
# dead URL (e.g. localhost:3000, only up when someone runs
# `cd tels-brand-openedx && npm run serve` for local token iteration) its
# <link> is silently removed on error (onerror="this.remove()") and the
# app falls back to bare unbranded Paragon CSS from the CDN, with no
# visible error. That was exactly the previous value here -- do not
# reintroduce a hardcoded PARAGON_THEME_URLS unless you are deliberately
# live-iterating against `npm run serve` and know it's running.
PARAGON_THEME_URLS={}
