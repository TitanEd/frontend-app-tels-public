NODE_ENV='development'
PORT=8080
ACCESS_TOKEN_COOKIE_NAME='edx-jwt-cookie-header-payload'
BASE_URL='http://localhost:8080'
# Matches production's default MFE mount (tutor-tels-theme-plugins plugin.py
# HOME_URL="/public") — drives webpack's publicPath + frontend-platform's
# router basename (both read PUBLIC_PATH natively) AND localIndigoConfig.js's
# INDIGO_HOME_URL, so header/footer links, asset URLs, and client-side route
# matching all agree the app lives under /public, not the server root.
PUBLIC_PATH='/public'
CREDENTIALS_BASE_URL='http://localhost:18150'
CSRF_TOKEN_API_PATH='/csrf/api/v1/token'
ECOMMERCE_BASE_URL='http://localhost:18130'
LANGUAGE_PREFERENCE_COOKIE_NAME='openedx-language-preference'
LMS_BASE_URL='http://localhost:18000'
LOGIN_URL='http://localhost:18000/login'
LOGOUT_URL='http://localhost:18000/logout'
LOGO_URL=https://titaned.com/wp-content/uploads/2023/07/TitanEdLogo-Footer.png
LOGO_TRADEMARK_URL=https://titaned.com/wp-content/uploads/2023/07/TitanEdLogo-Footer.png
LOGO_WHITE_URL=https://titaned.com/wp-content/uploads/2023/07/TitanEdLogo-Footer.png
FAVICON_URL=https://titaned.com/wp-content/uploads/2023/09/cropped-TitanEd-Favicon-192x192.png
MARKETING_SITE_BASE_URL='http://localhost:8080'
ORDER_HISTORY_URL='http://localhost:1996/orders'
REFRESH_ACCESS_TOKEN_ENDPOINT='http://localhost:18000/login_refresh'
SEGMENT_KEY=''
SITE_NAME=TitanEd
USER_INFO_COOKIE_NAME='edx-user-info'
APP_ID='public'
MFE_CONFIG_API_URL=''
# TitanEd Template B (Harvard-PLL / tels-mirror) brand CSS (run: cd tels-brand-openedx && npm run serve)
PARAGON_THEME_URLS={"core":{"urls":{"default":"https://cdn.jsdelivr.net/npm/@openedx/paragon@23.14.9/dist/core.min.css","brandOverride":"http://localhost:3000/core.min.css"}},"defaults":{"light":"light","dark":"dark"},"variants":{"light":{"urls":{"default":"https://cdn.jsdelivr.net/npm/@openedx/paragon@23.14.9/dist/light.min.css","brandOverride":"http://localhost:3000/light.min.css"}},"dark":{"urls":{"default":"https://cdn.jsdelivr.net/npm/@openedx/paragon@23.14.9/dist/dark.min.css","brandOverride":"http://localhost:3000/dark.min.css"}}}}
